{{!
    @template local_pluginiaconnect/health

    Results of the diagnostics page.

    Context variables required for this template:
    * intro - Introductory text.
    * checks - List of results: name, statuslabel, badgeclass, message, hasremedy, remedy.

    Example context (json):
    {
        "intro": "These checks look at the server set-up the connector depends on.",
        "checks": [
            {
                "name": "HTTPS",
                "statuslabel": "OK",
                "badgeclass": "badge bg-success text-white",
                "message": "The site is served over HTTPS.",
                "hasremedy": false,
                "remedy": ""
            },
            {
                "name": "Cron",
                "statuslabel": "Error",
                "badgeclass": "badge bg-danger text-white",
                "message": "Cron has never run.",
                "hasremedy": true,
                "remedy": "Set up cron to run every minute."
            }
        ]
    }
}}
<div class="local-pluginiaconnect-health">
    <p>{{intro}}</p>
    <table class="table generaltable">
        <thead>
            <tr>
                <th scope="col">{{#str}}health_col_check, local_pluginiaconnect{{/str}}</th>
                <th scope="col">{{#str}}health_col_status, local_pluginiaconnect{{/str}}</th>
                <th scope="col">{{#str}}health_col_result, local_pluginiaconnect{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#checks}}
            <tr>
                <th scope="row">{{name}}</th>
                <td><span class="{{badgeclass}}">{{statuslabel}}</span></td>
                <td>
                    <div>{{message}}</div>
                    {{#hasremedy}}
                    <div class="small text-muted">{{remedy}}</div>
                    {{/hasremedy}}
                </td>
            </tr>
            {{/checks}}
        </tbody>
    </table>
</div>

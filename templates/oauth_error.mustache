{{!
    @template local_pluginiaconnect/oauth_error

    Error or explanation page of the OAuth authorization endpoint. The user is not redirected anywhere.

    Context variables required for this template:
    * message - What happened and what the user can do.
    * loginurl - Sign-in page, may be empty.

    Example context (json):
    {
        "message": "This application is not accepted by this site.",
        "loginurl": ""
    }
}}
<div class="local-pluginiaconnect-consent">
    <h2>{{#str}}consent_heading, local_pluginiaconnect{{/str}}</h2>
    <div class="alert alert-warning" role="alert">{{message}}</div>
    {{#loginurl}}
        <p><a class="btn btn-primary" href="{{loginurl}}">{{#str}}login{{/str}}</a></p>
    {{/loginurl}}
    <p>{{#str}}consent_closewindow, local_pluginiaconnect{{/str}}</p>
</div>

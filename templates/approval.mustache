{{!
    @template local_pluginiaconnect/approval

    A change requested by an AI assistant that waits for the user's approval.

    Context variables required for this template:
    * intro - Introductory text.
    * changed - Whether the change was described differently when it was last shown.
    * summary - Description of the exact change, built by the site.
    * tool - Name of the action.
    * requester - Application (and assistant) that requested the change.
    * requested - When it was requested.
    * expires - When the request expires.

    Example context (json):
    {
        "intro": "An AI assistant connected to your account asked to make this change. Nothing has been changed yet.",
        "changed": false,
        "summary": "Hide 'Unit 3 test' (Course: Statistics I). Currently visible to students.",
        "tool": "set_activity_visibility",
        "requester": "Pluginia Connect, on behalf of Microsoft 365 Copilot Cowork",
        "requested": "Tuesday, 24 November 2026, 10:00",
        "expires": "Tuesday, 24 November 2026, 10:15"
    }
}}
<div class="local-pluginiaconnect-approval" data-region="pc-approval">
    <p>{{intro}}</p>
    {{#changed}}
    <p class="alert alert-warning" role="alert">{{#str}}approval_changed, local_pluginiaconnect{{/str}}</p>
    {{/changed}}
    <div class="card mb-3">
        <div class="card-body">
            <h3 class="h5 card-title">{{#str}}approval_summary, local_pluginiaconnect{{/str}}</h3>
            <p class="card-text" data-region="pc-approval-summary">{{summary}}</p>
        </div>
    </div>
    <dl class="row">
        <dt class="col-sm-3">{{#str}}approval_tool, local_pluginiaconnect{{/str}}</dt>
        <dd class="col-sm-9">{{tool}}</dd>
        <dt class="col-sm-3">{{#str}}approval_requester, local_pluginiaconnect{{/str}}</dt>
        <dd class="col-sm-9">{{requester}}</dd>
        <dt class="col-sm-3">{{#str}}approval_requested, local_pluginiaconnect{{/str}}</dt>
        <dd class="col-sm-9">{{requested}}</dd>
        <dt class="col-sm-3">{{#str}}approval_expires, local_pluginiaconnect{{/str}}</dt>
        <dd class="col-sm-9">{{expires}}</dd>
    </dl>
</div>
